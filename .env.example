# Copy to .env.local and fill in. Never commit real values.
#
# Local development: `pnpm db:start` prints these. For a hosted project they
# are in the project's API settings.

# Public: safe in the browser. Row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only: processing inbound messages (no one is signed in when
# they arrive), the internal usage ledger and the demo seed. Owners' own
# requests never go through it.
# It bypasses row level security: never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-side only: reading customers' messages. Without a key, messages
# are still stored and go to the owner in Attention unread. Never prefix
# it with NEXT_PUBLIC_.
OPENAI_API_KEY=
# The model for reading messages (default gpt-5.6-luna) and its reasoning
# effort: none, minimal, low (default) or medium.
OPENAI_MESSAGE_MODEL=
OPENAI_MESSAGE_REASONING_EFFORT=

# Development only: "fixture" reads the sample messages in the evaluation
# corpus without calling OpenAI. Ignored in production.
PINGFLOW_MESSAGE_INTERPRETER=

# The email address `pnpm db:seed` creates the demo driving instructor for.
DEMO_OWNER_EMAIL=

# Local development only: the local mail catcher, linked from "Check your
# email" so you can open sign-in links. Leave unset anywhere else.
LOCAL_MAIL_INBOX_URL=
